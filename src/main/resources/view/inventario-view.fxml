<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="576.0" prefWidth="1050.0" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.recursos.humanos.controller.InventarioController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label text="Inventario de aspirantes" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUsuario" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
         </children>
      </HBox>
      <HBox prefHeight="421.0" prefWidth="1020.0" spacing="15.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tblAspirantes" prefHeight="511.0" prefWidth="523.0" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="110.0" text="Nombre" />
                  <TableColumn fx:id="colApellido" prefWidth="110.0" text="Apellido" />
                  <TableColumn fx:id="colCorreo" prefWidth="170.0" text="Correo" />
                  <TableColumn fx:id="colTelefono" prefWidth="95.0" text="Teléfono" />
                  <TableColumn fx:id="colDireccion" prefWidth="170.0" text="Dirección" />
                  <TableColumn fx:id="colEdad" minWidth="0.0" prefWidth="64.0" text="Edad" />
               </columns>
            </TableView>
            <VBox prefHeight="440.0" prefWidth="239.0" spacing="8.0">
               <children>
                  <Label text="Nombre" />
                  <TextField fx:id="txtNombre" />
                  <Label text="Apellido" />
                  <TextField fx:id="txtApellido" />
                  <Label text="Correo" />
                  <TextField fx:id="txtCorreo" />
                  <Label text="Teléfono" />
                  <TextField fx:id="txtTelefono" />
                  <Label text="Dirección" />
                  <TextField fx:id="txtDireccion" />
                  <Label text="Edad" />
                  <TextField fx:id="txtEdad" />
                  <HBox spacing="8.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#agregar" prefHeight="25.0" prefWidth="176.0" text="Agregar" />
                        <Button mnemonicParsing="false" onAction="#actualizar" prefHeight="25.0" prefWidth="175.0" text="Actualizar" />
                     </children>
                  </HBox>
                  <HBox spacing="8.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#eliminar" prefHeight="25.0" prefWidth="178.0" text="Eliminar" />
                        <Button mnemonicParsing="false" onAction="#limpiar" prefHeight="25.0" prefWidth="175.0" text="Limpiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
