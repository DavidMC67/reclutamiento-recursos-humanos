<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="360.0" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.recursos.humanos.controller.RegistroController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
   <children>
      <Pane prefHeight="35.0" prefWidth="300.0">
         <children>
            <Label layoutX="99.0" layoutY="6.0" text="Registro de usuario" />
         </children>
      </Pane>
      <Label text="Nombre" />
      <TextField fx:id="txtNombre" />
      <Label text="Apellido" />
      <TextField fx:id="txtApellido" />
      <Label text="Correo" />
      <TextField fx:id="txtCorreo" promptText="Ejemplo: admin@kinal.edu (debe llevar .kinal o .edu)" />
      <Label text="Contraseña" />
      <PasswordField fx:id="txtContrasena" promptText="6 dígitos" />
      <Label text="Rol" />
      <ComboBox fx:id="cmbRol" prefWidth="300.0" />
      <Pane prefHeight="34.0" prefWidth="300.0">
         <children>
            <Button layoutX="66.0" layoutY="8.0" mnemonicParsing="false" onAction="#registrar" text="Registrar" />
            <Button layoutX="165.0" layoutY="8.0" mnemonicParsing="false" onAction="#volver" prefHeight="25.0" prefWidth="63.0" text="Volver" />
         </children>
      </Pane>
   </children>
</VBox>
